---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import { CommandPalette } from '../components/palette/CommandPalette';
import { getSnapshot } from '../lib/data';
import { formatDate, formatNumber } from '../lib/format';
import { href } from '../lib/paths';
import { SITE_NAME, WEEKLY_FEED_TITLE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const snapshot = getSnapshot();
const { title, description = `Explore the ${formatNumber(snapshot.repository_count)} public GitHub repositories with ${formatNumber(snapshot.minimum_stars)}+ stars: search, filter, track what is rising, compare, and save shortlists.` } =
  Astro.props;

const primaryNav = [
  { label: 'Explore', href: href('/') },
  { label: 'Guides', href: href('/collections/') },
  { label: 'Compare', href: href('/compare/') },
  { label: 'Lists', href: href('/lists/') },
];
const moreNav = [
  { label: 'Rising', href: href('/rising/') },
  { label: 'Weekly', href: href('/weekly/') },
  { label: 'Topics', href: href('/topics/') },
  { label: 'Languages', href: href('/languages/') },
  { label: 'My stars', href: href('/stars/') },
  { label: 'About the data', href: href('/about/') },
];
const pageTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} · Top GitHub Repositories by Stars`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(href('/og.png'), Astro.site);
const palettePages = [...primaryNav, ...moreNav];
const path = Astro.url.pathname;
const isCurrent = (target: string) => (target === href('/') ? path === target : path.startsWith(target));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={WEEKLY_FEED_TITLE} href={href('/weekly/feed.xml')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Apply a saved theme before first paint. Without one, the system preference decides.
      try {
        const theme = localStorage.getItem('agr:theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="topbar">
      <div class="shell topbar-inner">
        <a class="brand" href={href('/')}>{SITE_NAME}</a>
        <nav class="nav" aria-label="Main">
          {primaryNav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <details class="nav-more" id="nav-more">
            <summary class:list={[{ 'is-current': moreNav.some((item) => isCurrent(item.href)) }]}>More</summary>
            <ul>
              {moreNav.map((item) => (
                <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
              ))}
            </ul>
          </details>
        </nav>
        <div class="topbar-actions">
          <button type="button" class="palette-button" data-palette-open aria-label="Quick search">
            <span>Search</span>
            <kbd>Ctrl K</kbd>
          </button>
          <button type="button" class="icon-button" id="theme-toggle" aria-label="Switch between light and dark theme">
            <svg class="icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path d="M8 1.5a6.5 6.5 0 1 0 0 13z" fill="currentColor"></path>
              <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="shell">
      <p class="notice freshness-notice" id="snapshot-freshness" hidden>
        The daily catalog refresh is overdue. Last updated <time datetime={snapshot.generated_at}>{formatDate(snapshot.generated_at)}</time>.
      </p>
      <slot />
    </main>

    <footer class="footer">
      <div class="shell footer-inner">
        <span>
          {formatNumber(snapshot.repository_count)} repositories · data from {formatDate(snapshot.generated_at)}
        </span>
        <span>Stars are a snapshot, not a verdict. <a href={href('/about/')}>About the data</a></span>
      </div>
    </footer>

    <CommandPalette client:load pages={palettePages} />

    <script>
      const more = document.querySelector<HTMLDetailsElement>('#nav-more');
      if (more) {
        more.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && more.open) {
            event.stopPropagation();
            more.open = false;
            more.querySelector('summary')?.focus();
          }
        });
        more.addEventListener('focusout', (event) => {
          if (!more.contains(event.relatedTarget as Node | null)) more.open = false;
        });
        document.addEventListener('click', (event) => {
          if (!more.contains(event.target as Node | null)) more.open = false;
        });
      }

      const freshness = document.getElementById('snapshot-freshness');
      const timestamp = Date.parse(freshness?.querySelector('time')?.dateTime ?? '');
      if (freshness && Number.isFinite(timestamp)) {
        const updateFreshness = () => {
          freshness.hidden = Date.now() - timestamp < 48 * 60 * 60 * 1000;
        };
        updateFreshness();
        window.addEventListener('pageshow', updateFreshness);
        document.addEventListener('visibilitychange', updateFreshness);
      }

      const root = document.documentElement;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const current = root.dataset.theme ?? (systemDark ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('agr:theme', next);
        } catch {
          // The choice still applies to this page view.
        }
      });
    </script>
  </body>
</html>
