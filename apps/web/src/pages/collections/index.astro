---
import Base from '../../layouts/Base.astro';
import { featuredGuides, getSnapshot } from '../../lib/data';
import { collectionPath } from '../../lib/paths';

const featured = featuredGuides();
const collections = getSnapshot().collections.filter((collection) => !featured.includes(collection));
---

<Base title="Guides" description="Choose tools with practical trade-offs and browse hand-picked GitHub repository collections.">
  <header class="page-head">
    <h1>Guides</h1>
    <p class="lede">Compare tools for a specific job and discover hand-picked repositories.</p>
  </header>

  <ul class="card-grid">
    {
      [...featured, ...collections].map((collection) => (
        <li>
          <a class="card" href={collectionPath(collection.id)}>
            <span class="eyebrow">{collection.audience}</span>
            <h2>{collection.title}</h2>
            <p>{collection.description}</p>
            <span class="card-foot">
              {collection.decisions?.length
                ? `${collection.decisions.length} ${collection.decisions.length === 1 ? 'decision' : 'decisions'}`
                : `${collection.entries.length} ${collection.entries.length === 1 ? 'repository' : 'repositories'}`}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
