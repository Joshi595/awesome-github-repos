---
import { CompareApp } from '../components/compare/CompareApp';
import Base from '../layouts/Base.astro';
import { getSnapshot } from '../lib/data';

const guides = getSnapshot().collections.flatMap((collection) =>
  (collection.decisions ?? []).map((decision) => ({
    ...decision,
    guide: collection.id,
    guideTitle: collection.title,
  })),
);
---

<Base title="Compare" description="Compare up to four GitHub repositories side by side: stars, momentum, activity, license and topics.">
  <header class="page-head">
    <p class="eyebrow">Tools</p>
    <h1>Compare repositories</h1>
    <p class="lede">Compare the trade-offs, maintenance, and activity of up to four repositories.</p>
  </header>
  <CompareApp client:load guides={guides} />
</Base>
